<?xml version="1.0" encoding="utf-8"?>
<!-- The outline over widget_background_r16; tinted by the widget that draws it. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <!-- Explicitly clear: tinted without a fill colour, a shape fills itself black first. -->
    <solid android:color="@android:color/transparent" />
    <stroke android:width="1.5dp" android:color="@color/widget_on_surface_variant" />
    <corners android:radius="16dp" />
</shape>
